*{
margin:0;
padding:0;
box-sizing:border-box;
}

html{
color-scheme:light;
}

body{
font-family:Arial,sans-serif;
background-color:#f4f8f4;
color:#333;
line-height:1.6;
}

header{
background:linear-gradient(90deg,#ff9800,#ffb74d);
color:white;
text-align:center;
padding:40px;
}

header h1{
font-size:40px;
}

.menu{
background:#2e7d32;
text-align:center;
padding:15px;
display:flex;
justify-content:center;
flex-wrap:wrap;
gap:10px;
}

.btn{
display:inline-block;
padding:10px 18px;
background:#ff9800;
color:white;
text-decoration:none;
border-radius:10px;
font-weight:bold;
transition:0.3s;
}

.btn:hover{
background:#fb8c00;
transform:scale(1.05);
}

.container{
width:90%;
max-width:1200px;
margin:20px auto;
}

section{
background:white;
margin-bottom:20px;
padding:25px;
border-radius:10px;
box-shadow:0 0 10px rgba(0,0,0,0.1);
}

h2{
color:#2e7d32;
margin-bottom:15px;
}

h3{
margin-top:10px;
margin-bottom:10px;
color:#ef6c00;
}

.galeria{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:20px;
}

.galeria img{
width:280px;
height:200px;
object-fit:cover;
border-radius:10px;
border:3px solid #ff9800;
}

ul{
margin-left:20px;
}

footer{
background:#2e7d32;
color:white;
text-align:center;
padding:20px;
margin-top:20px;
}

@media(max-width:768px){

.menu{
padding:10px;
gap:8px;
}

.btn{
padding:8px 14px;
font-size:14px;
}

header h1{
font-size:28px;
}

section{
padding:18px;
}

}