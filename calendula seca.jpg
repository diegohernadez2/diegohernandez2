*{
box-sizing:border-box;
margin:0;
padding:0;
}

html{
color-scheme:light;
}

body{
background-image:url("img/fondo.gif");
font-family:Arial,sans-serif;
}

#contenedor{
border:5px solid #d2691e;
width:90%;
margin:0 auto;
}

#cabecera{
background-color:hsla(28,100%,60%,0.6);
padding:30px;
text-align:center;
}

.menu{
text-align:center;
padding:15px;
background-color:hsla(40,100%,85%,0.7);
display:flex;
justify-content:center;
flex-wrap:wrap;
gap:10px;
}

.btn{
display:inline-block;
padding:10px 18px;
background:#d2691e;
color:white;
text-decoration:none;
border-radius:10px;
font-weight:bold;
transition:0.3s;
}

.btn:hover{
background:#ff9800;
transform:scale(1.05);
}

.izquierdo{
float:left;
width:20%;
text-align:center;
padding:0 20px;
background-color:hsla(120,60%,40%,0.7);
height:100%;
margin-top:7px;
}

.cuerpo{
height:auto;
margin-top:7px;
float:left;
width:60%;
padding:0 20px;
background-color:hsla(45,100%,60%,0.6);
}

.derecho{
background-color:hsla(90,70%,50%,0.6);
float:left;
width:20%;
height:100%;
padding:15px;
margin-top:7px;
text-align:center;
}

.pie{
background-color:hsla(30,100%,50%,0.5);
text-align:center;
padding:10px;
margin-top:7px;
clear:both;
}

@media only screen and (max-width:620px){

.derecho,
.cuerpo,
.izquierdo{
width:100%;
}

.menu{
padding:10px;
gap:8px;
}

.btn{
padding:8px 14px;
font-size:14px;
}

}

#alinear{
display:flex;
flex-wrap:wrap;
}

#scrolll{
overflow:auto;
}

table,
th,
td{
border:2px solid #228B22;
}

.img{
width:325px;
height:250px;
margin:15px auto;
display:block;
}

img,
video,
iframe{
max-width:100%;
display:block;
margin:0 auto;
max-height:100%;
border-radius:6px;
}

.copyright{
width:10px;
height:10px;
display:inline-block;
}

.redes{
width:20px;
height:20px;
display:inline-block;
margin:0 5px;
}

p{
font-size:16px;
color:#2c3e50;
margin:10px 0;
text-align:justify;
}

#imglogo{
max-width:5%;
width:auto;
height:auto;
float:left;
}

.img:hover{
filter:grayscale(0%) opacity(100%) drop-shadow(0 0 5px #228B22);
transform:scale(1.1);
}

.redes:hover{
filter:grayscale(0%) opacity(100%) drop-shadow(0 0 5px #d2691e);
transform:scale(1.6);
}

#imglogo:hover{
filter:grayscale(0%) opacity(100%) drop-shadow(0 0 5px #ff689D);
transform:scale(1.2);
}

iframe:hover,
video:hover{
filter:grayscale(0%) opacity(100%) drop-shadow(0 0 5px #228B22);
transform:scale(1.05);
}

h1,
h2,
h3,
h4,
h5,
h6{
font-family:'Nunito',sans-serif;
text-align:center;
color:#8B4513;
margin:15px 0;
}

.mensaje{
animation:fade 3s infinite;
color:#d2691e !important;
font-weight:bold;
}

@keyframes fade{

0%,
100%{
opacity:0;
}

50%{
opacity:1;
}

}

ul,
ol{
margin-left:20px;
margin-bottom:15px;
}